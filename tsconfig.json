{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./public/dist",
    "paths": {
      "@/*": [
        "./app/*"
      ]
    },
    "removeComments": true,
    "resolveJsonModule": true,
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": [
      "@react-router/node",
      "vite/client"
    ]
  },
  // Exclude noisy vendored modules that should not be typechecked
  "exclude": [
    "dist",
    "node_modules",
    "node_modules/**",
    "node_modules.nosync",
    "node_modules.nosync/**"
  ],
  "include": [
    ".react-router/types/**/*",
    "env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/.server/**/*.ts",
    "**/.server/**/*.tsx",
    "**/.client/**/*.ts",
    "**/.client/**/*.tsx",
    "postcss.config.mjs"
  ],
  // Vite takes care of building everything, not tsc.
  "noEmit": true
}