  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "docker compose up -d --wait --remove-orphans && echo '🚀 Docker services are ready!' && react-router dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint . --max-warnings 0 || true",
    "lint-nc": "rm -rf ./node_modules/.cache/eslint && eslint --no-cache --max-warnings 0 || true",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:push": "prisma db push --force-reset",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:usage": "tsx prisma/verify-db-usage.ts",
    "key:generate-session-secret": "node scripts/generate-session-secret.mjs",
    "draco:copy": "node scripts/draco.cjs",
    "update": "pnpm update --latest && pnpm postinstall",
    "postinstall": "pnpm run draco:copy && patch-package",
    "prepare": "patch-package"
  },
