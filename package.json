{
  "name": "portfolio",
  "homepage": "https://www.angelo-dagostino.com",
  "description": "Portfolio site for Angelo D'Agostino",
  "repository": "https://github.com/iamadagostino/portfolio.git",
  "author": "Angelo D'Agostino",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "docker compose up -d --wait --remove-orphans && echo '🚀 Docker services are ready!' && react-router dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint . --max-warnings 0 || true",
    "lint-nc": "rm -rf ./node_modules/.cache/eslint && eslint --no-cache --max-warnings 0 || true",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:push": "prisma db push --force-reset",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:usage": "tsx prisma/verify-db-usage.ts",
    "key:generate-session-secret": "node scripts/generate-session-secret.mjs",
    "draco:copy": "node scripts/draco.cjs",
    "update": "pnpm update --latest && pnpm postinstall",
    "postinstall": "pnpm run draco:copy && prisma generate && patch-package",
    "prepare": "patch-package"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1141.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@lordicon/react": "^1.11.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@react-router/cloudflare": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@uidotdev/usehooks": "^2.4.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "flag-icons": "^7.5.0",
    "framer-motion": "^13.4.4",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-fs-backend": "^2.6.8",
    "i18next-http-backend": "^4.0.2",
    "isbot": "^5.2.2",
    "jotai": "^3.0.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "pg": "^8.23.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "^8.4.0",
    "rehype-img-size": "^1.0.1",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
